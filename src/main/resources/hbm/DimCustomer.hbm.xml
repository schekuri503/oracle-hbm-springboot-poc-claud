<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.example.oraclehbm.model.DimCustomer" table="DIM_CUSTOMER">

        <id name="customerId" column="CUSTOMER_ID" type="java.lang.Long">
            <generator class="native">
                <param name="sequence_name">DIM_CUSTOMER_SEQ</param>
            </generator>
        </id>

        <property name="region" column="REGION" type="java.lang.String" length="100"/>
        <property name="segment" column="SEGMENT" type="java.lang.String" length="100"/>
        <property name="createdDt" column="CREATED_DT" type="java.time.LocalDate"/>

    </class>
</hibernate-mapping>
