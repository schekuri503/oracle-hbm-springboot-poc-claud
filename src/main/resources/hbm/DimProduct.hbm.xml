<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.example.oraclehbm.model.DimProduct" table="DIM_PRODUCT">

        <id name="productId" column="PRODUCT_ID" type="java.lang.Long">
            <generator class="native">
                <param name="sequence_name">DIM_PRODUCT_SEQ</param>
            </generator>
        </id>

        <property name="category" column="CATEGORY" type="java.lang.String" length="100"/>
        <property name="brand" column="BRAND" type="java.lang.String" length="100"/>
        <property name="basePrice" column="BASE_PRICE" type="java.math.BigDecimal" precision="15" scale="2"/>
        <property name="createdDt" column="CREATED_DT" type="java.time.LocalDate"/>

    </class>
</hibernate-mapping>
