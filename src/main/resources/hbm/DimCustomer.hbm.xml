<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="com.example.oraclehbm.model.DimCustomer" table="DIM_CUSTOMER">

        <id name="customerId" column="CUSTOMER_ID" type="java.lang.Long">
            <generator class="native">
                <param name="sequence_name">DIM_CUSTOMER_SEQ</param>
            </generator>
        </id>

        <property name="customerName" column="CUSTOMER_NAME" type="java.lang.String" length="200" not-null="true"/>
        <property name="email" column="EMAIL" type="java.lang.String" length="150"/>
        <property name="phone" column="PHONE" type="java.lang.String" length="30"/>
        <property name="address" column="ADDRESS" type="java.lang.String" length="500"/>
        <property name="city" column="CITY" type="java.lang.String" length="100"/>
        <property name="state" column="STATE" type="java.lang.String" length="100"/>
        <property name="country" column="COUNTRY" type="java.lang.String" length="100"/>
        <property name="postalCode" column="POSTAL_CODE" type="java.lang.String" length="20"/>
        <property name="createdDate" column="CREATED_DATE" type="java.time.LocalDate"/>
        <property name="activeFlag" column="ACTIVE_FLAG" type="java.lang.Boolean"/>

    </class>
</hibernate-mapping>
